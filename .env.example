# SideraScan local development environment.
# Copy to .env and replace all dev-only placeholders before production.

# Core API / database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/siderascan_dev?schema=public"
API_PORT="4000"
API_BODY_LIMIT_BYTES="31457280"
WEB_ORIGIN="http://localhost:3000"
AUTH_SECRET="dev-only-change-this-secret-at-least-32-chars"
SESSION_COOKIE_NAME="siderascan_session"
SESSION_TTL_SECONDS="28800"

# Seeded Super Admin for local/dev only
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_USERNAME="superadmin"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe12345!"
SEED_SUPER_ADMIN_DISPLAY_NAME="Super Admin"

# Scanner API secrets
SCANNER_KEY_HASH_SECRET="dev-only-change-scanner-key-secret-32-chars"
SCANNER_UPLOAD_TOKEN_SECRET="dev-only-change-upload-token-secret-32-chars"
SCANNER_UPLOAD_TOKEN_TTL_SECONDS="1800"

# SideraScan API outbound n8n webhooks.
# These are NOT n8n container runtime variables.
# Local dev keeps both webhooks disabled so scan completion never depends on n8n.
N8N_SCAN_COMPLETED_WEBHOOK_URL="http://localhost:5678/webhook/siderascan-scan-completed"
N8N_WEBHOOK_SECRET="dev-only-change-n8n-webhook-secret-32-chars"
N8N_WEBHOOK_ENABLED="false"
N8N_MAX_ATTEMPTS="3"
N8N_SIGNATURE_TOLERANCE_SECONDS="300"
N8N_ALERT_WEBHOOK_URL="http://localhost:5678/webhook/siderascan-security-alert"
N8N_ALERT_WEBHOOK_ENABLED="false"
N8N_ALERT_MAX_ATTEMPTS="3"

# Executor intelligence feed
EXECUTOR_INTEL_ENABLED="true"
EXECUTOR_INTEL_SOURCE_URL="https://executors.online/api/executors"
EXECUTOR_INTEL_FALLBACK_URL="https://weao.xyz/api/status/exploits"
EXECUTOR_INTEL_CACHE_TTL_SECONDS="86400"
EXECUTOR_INTEL_AUTO_SYNC_ENABLED="true"
EXECUTOR_INTEL_AUTO_SYNC_INTERVAL_SECONDS="86400"
EXECUTOR_INTEL_SYNC_COOLDOWN_SECONDS="3600"

# Report export / retention
REPORT_EXPORT_MAX_FINDINGS="500"
RETENTION_SCAN_RESULTS_DAYS="90"
RETENTION_FINDINGS_EVIDENCE_DAYS="90"
RETENTION_SCREENSHOTS_DAYS="30"
RETENTION_DETECTION_SAMPLES_DAYS="7"
RETENTION_MONITORING_EVENTS_DAYS="30"
RETENTION_SECURITY_EVENTS_DAYS="180"
RETENTION_AUDIT_LOGS_DAYS="365"

# App URLs
APP_DASHBOARD_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
