  evidence      ScanEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([aiReviewId])
  @@index([scanSessionId])
  @@index([findingId])
  @@index([evidenceId])
  @@map("ai_review_evidence")
}

model AutomationEvent {
  id             String                @id @default(uuid()) @db.Uuid
