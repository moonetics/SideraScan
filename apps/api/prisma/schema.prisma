model AiReview {
  id                     String              @id @default(uuid()) @db.Uuid
  scanSessionId          String              @unique @map("scan_session_id") @db.Uuid
  accountId              String              @map("account_id") @db.Uuid
  assessment             String              @db.VarChar(80)
  confidence             Int
  summaryForModerator    String              @map("summary_for_moderator")
  summaryForPlayer       String?             @map("summary_for_player")
  recommendedAction      AiRecommendedAction @map("recommended_action")
  keyIndicators          Json                @default("[]") @map("key_indicators")
  possibleFalsePositives Json                @default("[]") @map("possible_false_positives")
  contradictions         Json                @default("[]")
  moderatorChecklist     Json                @default("[]") @map("moderator_checklist")
  questionsForPlayer     Json                @default("[]") @map("questions_for_player")
  evidenceReferences     Json                @default("[]") @map("evidence_references")
  model                  String?             @db.VarChar(120)
  promptVersion          String?             @map("prompt_version") @db.VarChar(80)
  inputHash              String?             @map("input_hash") @db.VarChar(128)
  generatedAt            DateTime            @map("generated_at") @db.Timestamptz(3)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  scanSession            ScanSession         @relation(fields: [scanSessionId], references: [id], onDelete: Cascade)
  account                Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  evidenceLinks          AiReviewEvidence[]

  @@index([accountId])
  @@index([assessment])
  @@index([recommendedAction])
  @@index([generatedAt])
  @@map("ai_reviews")
}

model AiReviewEvidence {
  id            String        @id @default(uuid()) @db.Uuid
  aiReviewId    String        @map("ai_review_id") @db.Uuid
  scanSessionId String        @map("scan_session_id") @db.Uuid
  findingId     String?       @map("finding_id") @db.Uuid
