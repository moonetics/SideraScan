model AlertNotification {
  id              String                  @id @default(uuid()) @db.Uuid
  securityEventId String?                 @map("security_event_id") @db.Uuid
  channel         String                  @db.VarChar(40)
  status          AlertNotificationStatus @default(PENDING)
  severity        MonitoringSeverity
  service         String                  @db.VarChar(80)
  eventType       String                  @map("event_type") @db.VarChar(120)
  idempotencyKey  String                  @unique @map("idempotency_key") @db.VarChar(180)
  payloadRedacted Json                    @map("payload_redacted")
  attemptCount    Int                     @default(0) @map("attempt_count")
  lastError       String?                 @map("last_error")
  lastAttemptAt   DateTime?               @map("last_attempt_at") @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  securityEvent   SecurityEvent?          @relation(fields: [securityEventId], references: [id], onDelete: Cascade)

  @@index([securityEventId])
  @@index([channel])
  @@index([status])
  @@index([severity])
  @@index([eventType])
  @@index([createdAt])
  @@map("alert_notifications")
}

