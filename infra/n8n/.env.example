# n8n runtime environment template.
# Copy to infra/n8n/.env for self-hosted n8n. Do not commit real values.
# These variables are for the n8n container and n8n PostgreSQL only.

# Image pinning
N8N_IMAGE_TAG="1.123.71"

# Public n8n URL behind HTTPS reverse proxy
N8N_HOST="n8n.example.com"
N8N_PROTOCOL="https"
N8N_PORT="5678"
WEBHOOK_URL="https://n8n.example.com/"

# Local development port binding.
# Compose binds this to 127.0.0.1 only; production should use a reverse proxy.
N8N_LOCAL_PORT="5678"

# Timezone
GENERIC_TIMEZONE="Asia/Jakarta"
TZ="Asia/Jakarta"

# n8n credential encryption.
# Generate a stable long random value and back it up securely.
N8N_ENCRYPTION_KEY="<generate-long-random-secret>"

# n8n PostgreSQL database
N8N_DB_PASSWORD="<generate-strong-password>"
DB_TYPE="postgresdb"
DB_POSTGRESDB_HOST="n8n-postgres"
DB_POSTGRESDB_PORT="5432"
DB_POSTGRESDB_DATABASE="n8n"
DB_POSTGRESDB_USER="n8n"
DB_POSTGRESDB_PASSWORD="<same-as-N8N_DB_PASSWORD>"

# SideraScan webhook verification for trusted workflow Code nodes.
# This must match SideraScan API N8N_WEBHOOK_SECRET.
SIDERASCAN_WEBHOOK_SECRET="<same-as-api-N8N_WEBHOOK_SECRET>"
SIDERASCAN_SIGNATURE_TOLERANCE_SECONDS="300"
NODE_FUNCTION_ALLOW_BUILTIN="crypto,https,process"

# Required so trusted self-hosted Code nodes can read SIDERASCAN_WEBHOOK_SECRET.
# Keep n8n admin access restricted when this is false.
N8N_BLOCK_ENV_ACCESS_IN_NODE="false"

# AI Review workflow.
# Gemini key is stored in n8n Credentials, not in this env file.
AI_PROVIDER="gemini"
GEMINI_MODEL="gemini-3.6-flash"
SIDERASCAN_API_BASE_URL="http://host.docker.internal:4000"
SIDERASCAN_AI_PROMPT_VERSION="n8n-ai-review-v2"

# Security Alert workflow.
# Put the real Discord webhook URL only in infra/n8n/.env or production secret manager.
DISCORD_SECURITY_ALERT_WEBHOOK_ENABLED="false"
DISCORD_SECURITY_ALERT_WEBHOOK_URL="<discord-webhook-url>"
